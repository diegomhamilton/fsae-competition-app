"HELMETS" = "Capacetes";
"HIGH PRESSURE HYDRAULIC SHIELDS" = "Proteções hidráulicas de alta pressão";
"HOLES AND OPENINGS IN REGULATED TUBES" = "Furos e aberturas em tubos regulamentados";
"HV CHARGING LEADS COLOR" = "Cor dos cabos de recarga de alta tensão";
